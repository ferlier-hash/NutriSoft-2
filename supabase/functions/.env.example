# Solo para Supabase Edge Functions. Copiar a supabase/functions/.env.local.
# Nunca agregar estos valores al frontend, .env.example raíz ni al repositorio.
GOOGLE_OAUTH_CLIENT_ID=435960702540-q52cmh5fmu39jitr2vtk82a358abh339.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
# Base64 de 32 bytes aleatorios. Se usa exclusivamente para cifrar refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY_BASE64=
# La función devuelve al profesional a esta URL tras la autorización.
GOOGLE_OAUTH_FRONTEND_RETURN_URL=http://127.0.0.1:5173/#/professional/settings
