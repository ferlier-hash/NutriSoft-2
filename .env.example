# Entorno público del frontend. Copiar como `.env.local` para desarrollo.
VITE_APP_ENV=local
VITE_ENABLE_DEMO_MODE=true

# Se completarán al conectar Supabase en la Fase 3.
# La anon/publishable key puede estar en el cliente; nunca usar service_role aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Observabilidad del frontend. Dejar vacío mientras no exista un proyecto configurado.
VITE_SENTRY_DSN=
